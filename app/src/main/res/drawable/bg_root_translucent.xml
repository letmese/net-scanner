<?xml version="1.0" encoding="utf-8"?>
<!-- Neon Glass translucent backdrop (API 31+, mockup #4): translucent dark tinted
     base + faint cyan top-right / magenta bottom-left neon orbs. Kept translucent
     so the system-blurred wallpaper shows through behind it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- translucent navy-black glass base (lets the blurred backdrop behind show through) -->
    <item>
        <shape>
            <gradient android:angle="270"
                android:startColor="#A60C1126"
                android:centerColor="#9E080A16"
                android:endColor="#8A04050D" />
        </shape>
    </item>
    <!-- faint neon cyan glow bleeding from the top-right -->
    <item android:top="-300dp" android:left="150dp" android:right="-180dp" android:bottom="120dp">
        <shape android:shape="oval">
            <gradient android:type="radial"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#2E00F0FF"
                android:endColor="#0000F0FF"
                android:gradientRadius="430dp" />
        </shape>
    </item>
    <!-- faint neon magenta glow bleeding from the bottom-left -->
    <item android:top="140dp" android:left="-240dp" android:right="140dp" android:bottom="-240dp">
        <shape android:shape="oval">
            <gradient android:type="radial"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#2AFF0080"
                android:endColor="#00FF0080"
                android:gradientRadius="400dp" />
        </shape>
    </item>
</layer-list>
