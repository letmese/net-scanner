<?xml version="1.0" encoding="utf-8"?>
<!-- Neon glass card (mockup #4): translucent dark-tinted frosted panel
     (RGBA ~12,14,30 @ ~72% alpha), 1dp cyan hairline border, ~24dp corners,
     thin white top-edge highlight. Blur comes from GlassWindow's backdrop. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <!-- soft drop shadow beneath the panel -->
            <item android:top="4dp" android:left="2dp" android:right="2dp" android:bottom="-2dp">
                <shape>
                    <corners android:radius="24dp" />
                    <solid android:color="#33000000" />
                </shape>
            </item>
            <!-- translucent dark-tinted frosted surface -->
            <item>
                <shape>
                    <corners android:radius="24dp" />
                    <solid android:color="#B90E0E1E" />
                    <stroke android:width="1dp" android:color="#7300F0FF" />
                </shape>
            </item>
            <!-- subtle white tint layer (makes it read as real glass) -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape>
                    <corners android:radius="22dp" />
                    <solid android:color="#12FFFFFF" />
                </shape>
            </item>
            <!-- thin white top-edge highlight -->
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="30dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#30FFFFFF"
                        android:centerColor="#0DFFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="23dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
