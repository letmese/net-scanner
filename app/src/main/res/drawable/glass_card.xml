<?xml version="1.0" encoding="utf-8"?>
<!-- Floating frosted glass panel: soft under-shadow, transparent tinted surface,
     hairline border, white tint layer, top edge shine. The blur itself is
     provided by GlassWindow's RenderEffect backdrop, so the surface stays thin. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <!-- soft drop shadow beneath the panel -->
            <item android:top="4dp" android:left="2dp" android:right="2dp" android:bottom="-2dp">
                <shape>
                    <corners android:radius="20dp" />
                    <solid android:color="#33000000" />
                </shape>
            </item>
            <!-- transparent frosted surface (bright top -> deeper base, ~40-55% alpha) -->
            <item>
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#B31F2B40"
                        android:centerColor="#96182132"
                        android:endColor="#730F1828" />
                    <corners android:radius="20dp" />
                    <stroke android:width="1dp" android:color="#5E9FB6D0" />
                </shape>
            </item>
            <!-- subtle white tint layer (makes it read as real glass) -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape>
                    <corners android:radius="18dp" />
                    <solid android:color="#12FFFFFF" />
                </shape>
            </item>
            <!-- top edge shine (frosted highlight) -->
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="28dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#2EFFFFFF"
                        android:centerColor="#0DFFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="19dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
