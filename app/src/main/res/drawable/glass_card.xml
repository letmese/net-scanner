<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glass background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_background" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Highlight top edge -->
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_highlight" />
            <corners
                android:topLeftRadius="19dp"
                android:topRightRadius="19dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>