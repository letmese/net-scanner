<?xml version="1.0" encoding="utf-8"?>
<!-- Floating frosted glass panel: soft under-shadow, translucent gradient surface, hairline border, top edge shine -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <!-- soft drop shadow beneath the panel -->
            <item android:top="4dp" android:left="2dp" android:right="2dp" android:bottom="-2dp">
                <shape>
                    <corners android:radius="20dp" />
                    <solid android:color="#3D000000" />
                </shape>
            </item>
            <!-- frosted translucent surface (bright top -> deeper base) -->
            <item>
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#F21F2B40"
                        android:centerColor="#E8182132"
                        android:endColor="#D80F1828" />
                    <corners android:radius="20dp" />
                    <stroke android:width="1dp" android:color="#529FB6D0" />
                </shape>
            </item>
            <!-- top edge shine (frosted highlight) -->
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="28dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#38FFFFFF"
                        android:centerColor="#14FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="19dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
