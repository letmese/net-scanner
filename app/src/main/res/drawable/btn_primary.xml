<?xml version="1.0" encoding="utf-8"?>
<!-- Neon primary accent button (mockup #4, scan trigger): magenta tint gradient,
     luminous magenta hairline, rounded. Dark label text stays readable on it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape>
            <gradient android:angle="270"
                android:startColor="#E6FF0080"
                android:centerColor="#BAFF0080"
                android:endColor="#8AFF0080" />
            <stroke android:width="1dp" android:color="#E6FF66B3" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
