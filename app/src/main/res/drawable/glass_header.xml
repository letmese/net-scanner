<?xml version="1.0" encoding="utf-8"?>
<!-- Neon glass header band (mockup #4): translucent dark tint, 1dp cyan hairline
     base border, white top shine, rounded base corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- translucent dark-tinted surface (bright top -> clear base) -->
    <item>
        <shape>
            <gradient android:angle="270"
                android:startColor="#CC0E0E1E"
                android:centerColor="#99100E1E"
                android:endColor="#88080A16" />
            <corners android:bottomLeftRadius="22dp" android:bottomRightRadius="22dp" />
            <stroke android:width="1dp" android:color="#4D00F0FF" />
        </shape>
    </item>
    <!-- subtle white tint layer -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="8dp">
        <shape>
            <gradient android:angle="270"
                android:startColor="#16FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:bottomLeftRadius="20dp" android:bottomRightRadius="20dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="10dp">
        <shape>
            <gradient android:angle="270"
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:bottomLeftRadius="21dp" android:bottomRightRadius="21dp" />
        </shape>
    </item>
</layer-list>
