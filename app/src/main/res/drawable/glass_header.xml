<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass header band: bright top, soft bottom fade, rounded base -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270"
                android:startColor="#F2233048"
                android:centerColor="#C0121A2A"
                android:endColor="#30121A2A" />
            <corners android:bottomLeftRadius="20dp" android:bottomRightRadius="20dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="10dp">
        <shape>
            <gradient android:angle="270"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:bottomLeftRadius="20dp" android:bottomRightRadius="20dp" />
        </shape>
    </item>
</layer-list>
