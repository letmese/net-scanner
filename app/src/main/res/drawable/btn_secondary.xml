<?xml version="1.0" encoding="utf-8"?>
<!-- Neon secondary button (mockup #4): translucent cyan tint, cyan hairline -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#30FFFFFF">
    <item>
        <shape>
            <gradient android:angle="270"
                android:startColor="#3300F0FF"
                android:centerColor="#1F00F0FF"
                android:endColor="#1200F0FF" />
            <stroke android:width="1dp" android:color="#4000F0FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
