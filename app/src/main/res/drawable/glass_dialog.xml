<?xml version="1.0" encoding="utf-8"?>
<!-- Neon glass dialog surface (mockup #4): translucent dark-tinted fill, 1dp cyan
     hairline border, rounded corners, thin white top highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft under-shadow -->
    <item android:top="5dp" android:left="3dp" android:right="3dp" android:bottom="-2dp">
        <shape>
            <corners android:radius="24dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>
    <!-- translucent dark-tinted frosted surface -->
    <item>
        <shape>
            <corners android:radius="24dp" />
            <solid android:color="#B90E0E1E" />
            <stroke android:width="1dp" android:color="#5E00F0FF" />
        </shape>
    </item>
    <!-- subtle white tint layer -->
    <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
        <shape>
            <corners android:radius="21dp" />
            <solid android:color="#12FFFFFF" />
        </shape>
    </item>
    <!-- thin white top-edge highlight -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="36dp">
        <shape>
            <gradient android:angle="270"
                android:startColor="#2AFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
