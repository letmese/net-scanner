<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- deep navy glass base (soft multi-stop) -->
    <item>
        <shape>
            <gradient android:angle="270"
                android:startColor="#FF141C2E"
                android:centerColor="#FF0C1220"
                android:endColor="#FF060910" />
        </shape>
    </item>
    <!-- aurora glow: cool cyan bleeding from the top -->
    <item android:top="-320dp" android:left="-120dp" android:right="-120dp">
        <shape android:shape="oval">
            <gradient android:type="radial"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#2E38BDF8"
                android:endColor="#0038BDF8"
                android:gradientRadius="420dp" />
        </shape>
    </item>
    <!-- aurora glow: deep blue on the left -->
    <item android:top="-60dp" android:left="-260dp" android:right="140dp" android:bottom="-160dp">
        <shape android:shape="oval">
            <gradient android:type="radial"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#264C6BC0"
                android:endColor="#004C6BC0"
                android:gradientRadius="380dp" />
        </shape>
    </item>
    <!-- aurora glow: violet/magenta on the right -->
    <item android:top="60dp" android:left="180dp" android:right="-260dp" android:bottom="-120dp">
        <shape android:shape="oval">
            <gradient android:type="radial"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#228181F2"
                android:endColor="#008181F2"
                android:gradientRadius="360dp" />
        </shape>
    </item>
</layer-list>
