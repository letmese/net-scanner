<?xml version="1.0" encoding="utf-8"?>
<!-- Neon Glass base (mockup #4): deep navy-black base, cyan neon orb bleeding
     from the top-right, magenta neon orb bleeding from the bottom-left.
     Opaque fallback canvas for API &lt; 31 (no window blur / wallpaper behind). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- deep navy-black glass base -->
    <item>
        <shape>
            <gradient android:angle="270"
                android:startColor="#FF0C1126"
                android:centerColor="#FF080A16"
                android:endColor="#FF04050D" />
        </shape>
    </item>
    <!-- neon cyan glow bleeding from the top-right -->
    <item android:top="-300dp" android:left="150dp" android:right="-180dp" android:bottom="120dp">
        <shape android:shape="oval">
            <gradient android:type="radial"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#4A00F0FF"
                android:endColor="#0000F0FF"
                android:gradientRadius="430dp" />
        </shape>
    </item>
    <!-- neon magenta glow bleeding from the bottom-left -->
    <item android:top="140dp" android:left="-240dp" android:right="140dp" android:bottom="-240dp">
        <shape android:shape="oval">
            <gradient android:type="radial"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#45FF0080"
                android:endColor="#00FF0080"
                android:gradientRadius="400dp" />
        </shape>
    </item>
</layer-list>
