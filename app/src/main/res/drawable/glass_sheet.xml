<?xml version="1.0" encoding="utf-8"?>
<!-- Neon glass sheet (list rows / panels, mockup #4): translucent dark-tinted fill,
     1dp cyan hairline border, rounded corners, thin white top highlight.
     Blur comes from GlassWindow's backdrop. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft under-shadow -->
    <item android:top="3dp" android:left="1dp" android:right="1dp" android:bottom="-1dp">
        <shape>
            <corners android:radius="22dp" />
            <solid android:color="#26000000" />
        </shape>
    </item>
    <!-- translucent dark-tinted frosted surface -->
    <item>
        <shape>
            <corners android:radius="22dp" />
            <solid android:color="#B90E0E1E" />
            <stroke android:width="1dp" android:color="#5E00F0FF" />
        </shape>
    </item>
    <!-- subtle white tint layer -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#10FFFFFF" />
        </shape>
    </item>
    <!-- thin white top-edge highlight -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="24dp">
        <shape>
            <gradient android:angle="270"
                android:startColor="#24FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
