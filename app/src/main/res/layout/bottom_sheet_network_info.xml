<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheetNetworkInfo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_card"
    android:padding="24dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp"
    app:behavior_fitContents="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/network_info"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/onSurface"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SSID"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurfaceVariant" />
        <TextView
            android:id="@+id/tvSsid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurface"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BSSID"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurfaceVariant" />
        <TextView
            android:id="@+id/tvBssid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurface"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IP Address"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurfaceVariant" />
        <TextView
            android:id="@+id/tvLocalIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurface"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gateway"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurfaceVariant" />
        <TextView
            android:id="@+id/tvGateway"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurface"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Subnet Mask"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurfaceVariant" />
        <TextView
            android:id="@+id/tvSubnet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurface"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DNS"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurfaceVariant" />
        <TextView
            android:id="@+id/tvDns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurface"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Signal Strength"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurfaceVariant" />
        <TextView
            android:id="@+id/tvSignal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurface"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Frequency"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurfaceVariant" />
        <TextView
            android:id="@+id/tvFrequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurface"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Link Speed"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurfaceVariant" />
        <TextView
            android:id="@+id/tvLinkSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/onSurface"
            android:fontFamily="monospace" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseBottomSheet"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/refresh"
        android:onClick="closeBottomSheet" />

</LinearLayout>