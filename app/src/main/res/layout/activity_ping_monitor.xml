<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_root">

    <LinearLayout
        android:layout_marginTop="80dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textSize="26sp"
            android:textColor="#EDEDF2"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="📈 Ping Monitor"
            android:textSize="19sp"
            android:textColor="#EDEDF2"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_toggle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="▶ Start"
            android:textSize="12sp"
            android:textColor="#0E0E16"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_host"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="20dp"
        android:hint="Host to monitor"
        android:textSize="13sp"
        android:textColor="#EDEDF2"
        android:textColorHint="#5E5E70"
        android:inputType="text"
        android:maxLines="1"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="12dp" />

    <com.netscanner.tools.LatencyView
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_margin="20dp"
        android:background="@drawable/glass_sheet" />

    <TextView
        android:id="@+id/tv_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#8A8A99"
        android:paddingHorizontal="20dp" />
</LinearLayout>
