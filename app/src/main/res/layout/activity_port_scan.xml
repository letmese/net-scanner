<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_root">

    <!-- Header -->
    <LinearLayout
        android:layout_marginTop="80dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textSize="26sp"
            android:textColor="#EDEDF2"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_target"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="#EDEDF2"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scan mode buttons -->
        android:layout_marginTop="80dp"
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btn_top20"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="Top 20"
            android:textSize="12sp"
            android:textColor="#0E0E16"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_top100"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="Top 100"
            android:textSize="12sp"
            android:textColor="#EDEDF2"
            android:textStyle="bold"
            android:background="@drawable/btn_secondary"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    android:layout_marginTop="80dp"
    <!-- Custom range -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="10dp">

        <EditText
            android:id="@+id/et_from"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:hint="from"
            android:inputType="number"
            android:textSize="12sp"
            android:textColor="#EDEDF2"
            android:textColorHint="#5E5E70"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="–"
            android:textColor="#8A8A99"
            android:paddingHorizontal="8dp" />

        <EditText
            android:id="@+id/et_to"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:hint="to"
            android:inputType="number"
            android:textSize="12sp"
            android:textColor="#EDEDF2"
            android:textColorHint="#5E5E70"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="12dp" />

        <TextView
            android:id="@+id/btn_range"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="Range scan"
            android:textSize="12sp"
            android:textColor="#EDEDF2"
            android:textStyle="bold"
            android:background="@drawable/btn_secondary"
            android:paddingHorizontal="16dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#8A8A99"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#4ADE80"
        android:textStyle="bold"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:visibility="gone" />

        <!-- Saved port profiles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/btn_prof_save"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="💾 Save list"
            android:textSize="11sp"
            android:textColor="#EDEDF2"
            android:background="@drawable/btn_secondary"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_prof_load"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="📂 Profiles"
            android:textSize="11sp"
            android:textColor="#EDEDF2"
            android:background="@drawable/btn_secondary"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

<androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="14dp"
        android:layout_marginTop="6dp"
        android:overScrollMode="never" />
</LinearLayout>
