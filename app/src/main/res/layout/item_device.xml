<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="device"
            type="com.letmese.netscanner.data.NetworkDevice" />
        <variable
            name="onClick"
            type="android.view.View.OnClickListener" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        android:background="@drawable/glass_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:onClick="@{onClick}"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Status indicator -->
            <View
                android:id="@+id/statusIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Device icon -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/deviceIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_device_default"
                app:layout_constraintStart_toEndOf="@id/statusIndicator"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle" />

            <!-- Device name -->
            <TextView
                android:id="@+id/deviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:text="@{device.name}"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/onSurface"
                android:ellipsize="end"
                android:maxLines="1"
                app:layout_constraintStart_toEndOf="@id/deviceIcon"
                app:layout_constraintTop_toTopOf="@id/deviceIcon"
                app:layout_constraintEnd_toStartOf="@id/chevron" />

            <!-- Device IP -->
            <TextView
                android:id="@+id/deviceIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:text="@{device.ip}"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/onSurfaceVariant"
                app:layout_constraintStart_toEndOf="@id/deviceIcon"
                app:layout_constraintTop_toBottomOf="@id/deviceName"
                app:layout_constraintBottom_toBottomOf="@id/deviceIcon"
                app:layout_constraintEnd_toStartOf="@id/chevron" />

            <!-- Chevron -->
            <ImageView
                android:id="@+id/chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@string/device_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:tint="@color/outlineVariant" />

            <!-- Expandable details -->
            <LinearLayout
                android:id="@+id/detailsLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/deviceIcon"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/glass_border" />

                <TextView
                    android:id="@+id/macLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/device_mac"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/onSurfaceVariant" />

                <TextView
                    android:id="@+id/deviceMac"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{device.mac}"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/onSurface"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/vendorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/device_vendor"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/onSurfaceVariant" />

                <TextView
                    android:id="@+id/deviceVendor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{device.vendor}"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/onSurface" />

                <TextView
                    android:id="@+id/portsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_ports"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/onSurfaceVariant" />

                <TextView
                    android:id="@+id/devicePorts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{device.openPortsString}"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>