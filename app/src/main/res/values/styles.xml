<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_root</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FF060910</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">#FF0080</item>
        <item name="colorPrimary">#0C1220</item>
        <item name="colorPrimaryDark">#060910</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:alertDialogTheme">@style/GlassDialogTheme</item>
    </style>

    <!-- Frosted glass alert dialogs -->
    <style name="GlassDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog</item>
        <item name="android:windowIsFloating">true</item>
        <item name="colorAccent">#FF0080</item>
    </style>
</resources>
